# Copy to .env.local (gitignored) and fill in real values.
# Never commit .env.local, and never put the service_role key anywhere
# that isn't this file or Vercel's environment variables dashboard.

# Safe to be public — same key class as the app's old anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT safe to be public. Bypasses RLS on every table. Supabase Dashboard
# -> Project Settings -> API Keys -> service_role (reveal).
SUPABASE_SERVICE_ROLE_KEY=

# NOT safe to be public. Gates /api/cron/fx-rates (see vercel.json) --
# Vercel sends this automatically as "Authorization: Bearer <value>" on
# every cron invocation once it's set as a project env var. Generate with
# `openssl rand -hex 32`; a plain .env.local value is only needed if you
# want to hit the route yourself while developing.
CRON_SECRET=
