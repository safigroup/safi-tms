# Copy to .env.local (gitignored) and fill in real values.
# Never commit .env.local, and never put the service_role key anywhere
# that isn't this file or Vercel's environment variables dashboard.

# Safe to be public — same key class as the app's old anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT safe to be public. Bypasses RLS on every table. Supabase Dashboard
# -> Project Settings -> API Keys -> service_role (reveal).
SUPABASE_SERVICE_ROLE_KEY=

# NOT safe to be public. Gates /api/cron/fx-rates (see vercel.json) --
# Vercel sends this automatically as "Authorization: Bearer <value>" on
# every cron invocation once it's set as a project env var. Generate with
# `openssl rand -hex 32`; a plain .env.local value is only needed if you
# want to hit the route yourself while developing.
CRON_SECRET=

# NOT safe to be public. Resend (resend.com) API key for the email sent to
# platform admins on each landing-page demo request. Blank = requests are
# still saved and listed under Demo requests, just without the email.
RESEND_API_KEY=

# Optional sender for that email, e.g. "Safi TMS <notifications@yourdomain.com>"
# -- must be on a domain verified in Resend. Blank uses Resend's test sender,
# which only delivers to the Resend account's own email address.
DEMO_REQUEST_FROM=

# NOT safe to be public. Powers the Estimator page's AI cost insights
# (app/api/insights/routes/[id]/route.ts) -- a real, ongoing per-call cost,
# not a one-time setup. Leave unset and that feature just reports itself
# as unconfigured rather than failing the page. console.anthropic.com.
ANTHROPIC_API_KEY=
